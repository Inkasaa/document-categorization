# pyenv
#   For a library or app, you might want to share your .python-version.
#   Reference: https://github.com/pyenv/pyenv/blob/master/COMMANDS.md#pyenv-version
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used in a vitualenv, lock file can be ignored.
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to commit.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to commit
#   pdm.lock
#   pdm.toml
#   .pdm-plugins/

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

